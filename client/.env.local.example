# For mobile testing, copy this file to .env.local and update with your computer's IP

# Get your IP:
# Windows: ipconfig | findstr IPv4
# Mac/Linux: ifconfig | grep "inet "

# Backend API URL (replace with your computer's IP)
VITE_API_URL=http://192.168.0.106:5000

# Example for different scenarios:
# Development (same machine): http://localhost:5000
# Mobile testing (same WiFi):  http://192.168.0.106:5000
# ngrok tunnel:                https://abcd1234.ngrok.io
