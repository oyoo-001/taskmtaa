{
  "expo": {
    "name": "TaskMtaa",
    "slug": "taskmtaa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskmtaa.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TaskMtaa needs your location to find nearby tasks and gigs.",
        "NSCameraUsageDescription": "TaskMtaa needs access to your camera to take photos for tasks and gigs.",
        "NSPhotoLibraryUsageDescription": "TaskMtaa needs access to your photo library to select images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.taskmtaa.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskMtaa needs access to your photos to upload task images.",
          "cameraPermission": "TaskMtaa needs access to your camera to take photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3B82F6"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#3B82F6"
    }
  }
}
