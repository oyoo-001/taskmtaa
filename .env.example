# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://username:password@localhost:5432/taskmtaa

# Database Pool Configuration (Optional - defaults shown)
DB_POOL_MIN=5          # Minimum connections to keep alive
DB_POOL_MAX=50         # Maximum connections in pool (adjust based on DB plan)

# JWT Configuration
JWT_SECRET=your-super-secure-random-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-change-this-too
JWT_EXPIRES_IN=24h        # Access token valid for 24 hours
JWT_REFRESH_EXPIRES_IN=30d  # Refresh token valid for 30 days

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Redis Configuration (Optional - for Socket.io scaling)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Cloudinary Image Storage
# Create a Cloudinary account at https://cloudinary.com and copy the
# credentials from Dashboard -> Product Environment Credentials.
# Until these are set, image uploads return HTTP 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder inside your Cloudinary account (avatars and gig images
# are stored under subfolders of this).
CLOUDINARY_FOLDER=taskmtaa
